(#include <stdio.h>)

(fn main :int (argc :int argv :char**)
  (printf "%d\n" (% 17 5))
  (printf "%d\n" (&& (< 1 2) (> 2 1)))
  (printf "%d\n" (|| 0 0))
  (printf "%d\n" (! 0))
  (printf "%d\n" (& 12 10))
  (printf "%d\n" (| 12 10))
  (printf "%d\n" (^ 12 10))
  (printf "%d\n" (~ -9))
  (printf "%d\n" (<< 1 4))
  (printf "%d\n" (>> 32 2))
  (printf "%d\n" (- 5))

  (decl x :int 3)
  (decl p :int* (& x))
  (set x (+ (* p) 4))
  (printf "%d\n" x)

  (++ x)
  (-- x)
  (%= x 5)
  (printf "%d\n" x)
  (return 0))
