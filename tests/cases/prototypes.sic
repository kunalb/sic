(#include <stdio.h>)

(fn is_odd :int (n :int))          ; forward declaration

(fn is_even :int (n :int)
  (return (?: (== n 0) 1 (is_odd (- n 1)))))

(fn is_odd :int (n :int)
  (return (?: (== n 0) 0 (is_even (- n 1)))))

(decl counter :extern-int)         ; extern declaration
(decl counter :int 40)

(fn main :int (argc :int argv :char**)
  (printf "%d %d\n" (is_even 10) (is_odd 7))
  (printf "%d\n" counter)
  (return 0))
