(#include <stdio.h> <stdlib.h>)

(fn main :int (argc :int argv :char**)
  (decl a :int[4])
  (for (decl i :int 0) (< i 4) (++ i)
    (set (aref a i) (* i i)))
  (set (aref a 0) 42)
  (printf "%d %d %d %d\n" (aref a 0) (aref a 1) (aref a 2) (aref a 3))

  (decl p :int* (& (aref a 1)))
  (set (* p) 99)
  (printf "%d\n" (aref a 1))

  (decl d :div_t (div 17 5))
  (printf "%d %d\n" (. d quot) (. d rem))
  (decl dp :div_t* (& d))
  (set (-> dp rem) 7)
  (printf "%d\n" (. d rem))
  (return 0))
